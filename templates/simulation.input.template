# GCMC of CO2 in MIL-53(Al) lp, rigid framework -- generated by scripts/make_inputs.py
# Every physical choice below is explained in NOTES.md ("Phase 2").
SimulationType                MonteCarlo
NumberOfCycles                {cycles}          # production cycles (1 cycle = max(20, N) MC moves)
NumberOfInitializationCycles  {init_cycles}          # equilibration, discarded from averages
PrintEvery                    {print_every}           # status print -> loading-vs-cycle trace
RestartFile                   no

# ---- Force field: UFF framework LJ + TraPPE CO2, Lorentz-Berthelot, truncated LJ (12.0 A) + tail corrections
Forcefield                    local             # read ./pseudo_atoms.def, ./force_field_mixing_rules.def, ./force_field.def
CutOffVDW                     {cutoff}              # [A]
# ---- Electrostatics: Ewald summation, real-space cutoff equal to the LJ cutoff
ChargeMethod                  Ewald
CutOffChargeCharge            {cutoff}              # [A]
EwaldPrecision                1e-6              # relative accuracy -> sets alpha and k-vectors
UseChargesFromCIFFile         {use_cif_charges}               # framework partial charges from the CIF (_atom_site_charge)

# ---- Framework (rigid: no framework moves are defined)
Framework 0
FrameworkName                 {framework}
RemoveAtomNumberCodeFromLabel yes               # 'Al1','O12' -> 'Al','O' to match pseudo_atoms.def
UnitCells                     {unit_cells}             # all perpendicular box widths > 2 x cutoff
HeliumVoidFraction            {helium_vf}          # from runs/helium_void_fraction (needed for excess loading)
ExternalTemperature           {temperature}
ExternalPressure              {pressure}

# ---- Adsorbate: rigid 3-site TraPPE CO2 (./CO2.def)
# No 'FugacityCoefficient' keyword -> RASPA computes it with the Peng-Robinson EOS
# from the critical constants in CO2.def (this is RASPA2's default).
Component 0 MoleculeName             CO2
            MoleculeDefinition       local
            TranslationProbability   0.5       # relative weights, normalised by RASPA:
            RotationProbability      0.5       #   translation/rotation/reinsertion 20 % each,
            ReinsertionProbability   0.5       #   swap (insert/delete) 40 %
            SwapProbability          1.0
            CreateNumberOfMolecules  0
