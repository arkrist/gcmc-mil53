# Helium void fraction of the rigid framework (Widom insertion of a He probe) -- generated by scripts/make_inputs.py
# theta_He = <exp(-beta U_He-framework)> over random positions; used as the pore volume in excess = absolute - rho_bulk * V_pore.
SimulationType        MonteCarlo
NumberOfCycles        {cycles}
PrintEvery            10000
PrintPropertiesEvery  10000

Forcefield            local
CutOffVDW             12.8
UseChargesFromCIFFile no

Framework 0
FrameworkName                 {framework}
RemoveAtomNumberCodeFromLabel yes
UnitCells                     {unit_cells}
ExternalTemperature           298.0

Component 0 MoleculeName             helium
            MoleculeDefinition       local
            WidomProbability         1.0
            CreateNumberOfMolecules  0
